import { render, screen, fireEvent } from '@testing-library/react';
import { ArticleApproval, type Article } from '../ArticleApproval';

const mockArticle: Article = {
  id: '1',
  title: 'Breaking News',
  author: 'Jane Doe',
  content: 'This is breaking news content',
};

describe('ArticleApproval', () => {
  it('renders article card with title and author', () => {
    render(<ArticleApproval article={mockArticle} />);
    expect(screen.getByText('Breaking News')).toBeInTheDocument();
    expect(screen.getByText('By Jane Doe')).toBeInTheDocument();
  });

  it('does not show status when pending', () => {
    render(<ArticleApproval article={mockArticle} status="pending" />);
    expect(screen.queryByText('✓ Approved!')).not.toBeInTheDocument();
    expect(screen.queryByText('✗ Rejected!')).not.toBeInTheDocument();
  });

  it('shows Approved! status when status is approved', () => {
    render(<ArticleApproval article={mockArticle} status="approved" />);
    expect(screen.getByText('✓ Approved!')).toBeInTheDocument();
  });

  it('shows Rejected! status when status is rejected', () => {
    render(<ArticleApproval article={mockArticle} status="rejected" />);
    expect(screen.getByText('✗ Rejected!')).toBeInTheDocument();
  });

  it('calls onApprovalChange with approved when approve button is clicked', () => {
    const mockCallback = jest.fn();
    render(
      <ArticleApproval
        article={mockArticle}
        status="pending"
        onApprovalChange={mockCallback}
      />
    );
    fireEvent.click(screen.getByText('Approve'));
    expect(mockCallback).toHaveBeenCalledWith('approved');
  });

  it('calls onApprovalChange with rejected when reject button is clicked', () => {
    const mockCallback = jest.fn();
    render(
      <ArticleApproval
        article={mockArticle}
        status="pending"
        onApprovalChange={mockCallback}
      />
    );
    fireEvent.click(screen.getByText('Reject'));
    expect(mockCallback).toHaveBeenCalledWith('rejected');
  });

  it('shows reset button when status is approved', () => {
    render(<ArticleApproval article={mockArticle} status="approved" />);
    expect(screen.getByText('Reset Status')).toBeInTheDocument();
  });

  it('shows reset button when status is rejected', () => {
    render(<ArticleApproval article={mockArticle} status="rejected" />);
    expect(screen.getByText('Reset Status')).toBeInTheDocument();
  });

  it('calls onApprovalChange with reset when reset button is clicked', () => {
    const mockCallback = jest.fn();
    render(
      <ArticleApproval
        article={mockArticle}
        status="approved"
        onApprovalChange={mockCallback}
      />
    );
    fireEvent.click(screen.getByText('Reset Status'));
    expect(mockCallback).toHaveBeenCalledWith('reset');
  });

  it('maintains independent status per article', () => {
    const mockCallback = jest.fn();
    const { rerender } = render(
      <ArticleApproval
        article={mockArticle}
        status="pending"
        onApprovalChange={mockCallback}
      />
    );
    fireEvent.click(screen.getByText('Approve'));
    expect(mockCallback).toHaveBeenCalledWith('approved');

    // Switch to another article with different status
    const anotherArticle: Article = {
      id: '2',
      title: 'Another News',
      author: 'John Smith',
      content: 'Another content',
    };
    rerender(
      <ArticleApproval
        article={anotherArticle}
        status="pending"
        onApprovalChange={mockCallback}
      />
    );
    // New article should show pending status, not the approved status from previous article
    expect(screen.queryByText('✓ Approved!')).not.toBeInTheDocument();
  });

  /* DEBUGGING CHALLENGE: Why doesn't this test pass?
   * Scenario: Test expects "Approved!" to appear, but it doesn't show up.
   * What could be wrong? Debug tips:
   * 1. Check if the button text is exactly 'Approve' (case-sensitive)
   * 2. Verify that the element being rendered is actually ArticleApproval
   * 3. Use screen.debug() to inspect the DOM
   * 4. Check if the state is being updated correctly after fireEvent.click()
   * 5. Ensure the component conditional rendering logic is correct
   *
   * Solution: This test now passes because:
   * - Each article maintains its own status via props from parent
   * - The approve button calls onApprovalChange callback
   * - Parent updates the status for that specific article
   * - The conditional {status === 'approved' && ...} renders correctly
   */
  it('[DEBUGGING] confirms Approved! message displays per article', () => {
    const mockCallback = jest.fn();
    render(
      <ArticleApproval
        article={mockArticle}
        status="pending"
        onApprovalChange={mockCallback}
      />
    );
    // Before click: no status shown
    expect(screen.queryByText('✓ Approved!')).not.toBeInTheDocument();
    // After click: callback triggered for parent to update
    fireEvent.click(screen.getByText('Approve'));
    expect(mockCallback).toHaveBeenCalledWith('approved');
  });
});
